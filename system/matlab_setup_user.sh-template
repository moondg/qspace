# -------------------------------------------------------------------- #
# User specific setup of the Matlab environment for QSpace             #
# -------------------------------------------------------------------- #

## Environmental variables: Matlab version and C++ compiler

 # Matlab specifies supported C++ compilers for mex/mcc compilation
 # depending on the Matlab release version. For more information, see e.g.
 # https://www.mathworks.com/support/requirements/supported-compilers-linux.html
 # https://www.mathworks.com/support/requirements/previous-releases.html
 # Therefore please run
 #
 #     'mex -setup C++'
 #
 # for the specification of the C++ compiler. This process must
 # be repeated if one switches to a new Matlab release version.

## Matlab installation root directory MATLAB_ROOT
## required for MEX compilation etc.
 # export MATLAB_ROOT="your-matlab-path (excluding ./bin)"

 # if MATLAB_ROOT is not yet set, the following chooses
 # the module system as another way to define MATLAB_ROOT;
 # this may be configured such that it also defines MATLAB_ROOT.
 # if MATLAB_ROOT is still not set after that,
 # then the wrap up per script matlab_setup.pl called below
 # will check whether Matlab is already available on the
 # path as the last check to set MATLAB_ROOT accordingly.

   if [ -z $MATLAB_ROOT ]; then
      if `type module >/dev/null 2>&1`; then
         module load matlab/2022b
         module load xcode/13.4    # e.g., macOS
       # module load gcc/8.4.0     # e.g., linux
      fi
   fi

## Further QSpace specific directory settings (adapt as necessary)
## For default values see matlab_setup.sh
## Therefore typically no need to set these values here
 # export MYMATLAB=$HOME/Matlab

## LMA = local Matlab data directory (default for data storage)
## used by lib/cto.m as in `cto lma' to change directory to $LMA
   if [ ! $LMA ]; then
      export LMA=/data/$USER/Data
   fi
   if [ ! $RC_STORE ]; then
      export RC_STORE=$LMA/RCStore
      export RC_SYNC=$LMA/RCSync
   fi

## level of parallization of the MEX routines
## this overwrites the defaults chosen by matlab_setup.pl
 # export QSP_NUM_THREADS=2  # QSpace specific
 # export OMP_NUM_THREADS=4  # Intel MKL library
 # export MKL_NUM_THREADS=4  # Intel MKL library

## used for parallelization of MEX compilation
## alternative to make -j $MSLOTS ... (see Source/Makefile)
 # export MSLOTS=12

